/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "./projects",
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    /* Reading past the end of an array, or off a map with a key that is not
       there, hands back `undefined`. Without this, the fake backend's handler
       map typed a two-level index as always present and a DELETE would have
       thrown a TypeError on the second level. */
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "ngx-statewise": ["./dist/ngx-statewise"],
      "ngx-statewise/testing": ["./dist/ngx-statewise/testing"],
      "@shared/*": ["./projects/ngx-statewise-showcase/src/app/shared/*"],
      "@assets/*": ["./projects/ngx-statewise-showcase/src/assets/*"],
      "@app/*": ["./projects/ngx-statewise-showcase/src/app/*"],
      "@testing/*": ["./projects/ngx-statewise-showcase/src/testing/*"],
      "@themes/*": [
        "./projects/ngx-statewise-showcase/src/assets/styles/themes/*"
      ]
    },
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
