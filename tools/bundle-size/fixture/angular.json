{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sizing": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sizing",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
