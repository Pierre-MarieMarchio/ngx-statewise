{
  "name": "ngx-statewise",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve ngx-statewise-showcase",
    "build": "npm run build:library && npm run build:showcase",
    "build:library": "ng build ngx-statewise",
    "build:showcase": "ng build ngx-statewise-showcase",
    "watch": "ng build ngx-statewise --watch --configuration development",
    "test": "npm run test:library",
    "test:library": "ng test ngx-statewise --watch=false --browsers=ChromeHeadless",
    "test:coverage": "npm run test:library -- --code-coverage",
    "test:showcase": "ng test ngx-statewise-showcase --watch=false --browsers=ChromeHeadless",
    "// --- VERIFICATION ---": "the showcase resolves ngx-statewise to dist, so its tests run once the library is built",
    "check": "npm run format:check && npm run lint && npm run test:coverage && npm run build:library && npm run test:showcase && npm run build:showcase",
    "prepare": "husky",
    "// --- RELEASE MANAGEMENT ---": "version bumping and prerelease commands",
    "version:beta-graduate": "lerna version --conventional-commits --conventional-graduate --no-push --no-git-tag-version --yes && git add . && git commit -m \"chore(release): prepare next beta version release\"",
    "version:beta-release": "npx lerna version --conventional-commits --conventional-prerelease --preid beta --message \"chore(release): publish beta version\" --yes",
    "version:stable-release": "npx lerna version --conventional-commits --conventional-graduate --message \"chore(realease): publish stable version\" --yes",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "projects/*"
  ],
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "lerna": "^8.2.2",
    "ng-packagr": "^22.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
