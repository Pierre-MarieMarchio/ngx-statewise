{
  "name": "ngx-statewise",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve ngx-statewise-showcase",
    "start:docs": "ng serve ngx-statewise-docs",
    "build": "npm run build:library && npm run build:showcase && npm run build:docs",
    "build:library": "ng build ngx-statewise",
    "build:showcase": "ng build ngx-statewise-showcase",
    "build:docs": "ng build ngx-statewise-docs",
    "watch": "ng build ngx-statewise --watch --configuration development",
    "verify:claims": "node scripts/verify-site-claims.mjs",
    "verify:docs": "node scripts/verify-docs-site.mjs",
    "test": "npm run test:library",
    "test:library": "ng test ngx-statewise --watch=false",
    "test:coverage": "npm run test:library -- --coverage",
    "test:showcase": "ng test ngx-statewise-showcase --watch=false",
    "test:docs": "ng test ngx-statewise-docs --watch=false",
    "// --- TOOLS ---": "the fixture resolves ngx-statewise to dist too, so it type-checks once the library is built",
    "typecheck:tools": "tsc -p tools/angular-compat/consumer/tsconfig.lint.json",
    "// --- VERIFICATION ---": "the showcase and the docs site resolve ngx-statewise to dist, so their tests run once the library is built",
    "check": "npm run format:check && npm run lint && npm run verify:docs && npm run test:coverage && npm run build:library && npm run typecheck:tools && npm run verify:claims && npm run test:showcase && npm run build:showcase && npm run test:docs && npm run build:docs",
    "// --- COMPATIBILITY ---": "kept out of `check`: each run installs a different Angular major from the registry",
    "verify:angular": "node tools/angular-compat/verify.mjs",
    "// --- RELEASE ---": "run from the library folder, where .release-it.json lives",
    "release:beta": "cd projects/ngx-statewise && release-it --preRelease=beta --npm.tag=beta",
    "release:stable": "cd projects/ngx-statewise && release-it --npm.tag=latest",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "private": true,
  "workspaces": [
    "projects/*"
  ],
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/ssr": "^22.1.7",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "jwt-decode": "^4.0.0",
    "marked": "^18.0.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "release-it": "^21.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
